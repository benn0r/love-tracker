{
  "name": "love-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,json,css,html,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,json,css,html,md,yml,yaml}\"",
    "build": "node --check server.js && node --check public/app.js && node --check public/respond.js && node --check public/i18n.js && node --check public/sw.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test test/server.test.js",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "eslint": "10.8.0",
    "globals": "16.5.0",
    "prettier": "3.9.6"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  }
}
